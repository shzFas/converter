# Скопируйте этот файл в .env и впишите токен:  cp .env.example .env
# Переменные из окружения важнее файла: WORKERS=4 go run ./cmd/bot

# Токен бота от @BotFather. Единственная обязательная настройка.
BOT_TOKEN=

# ID пользователей Telegram через запятую (свой ID подскажет @userinfobot).
# Админам доступны /stats, /allow, /disallow, /ban, /unban, /blockvideo, /unblockvideo.
ADMIN_IDS=
# Белый список. Пока он пуст и никто не добавлен через /allow, бот отвечает всем.
ALLOWED_USERS=

# Лимиты — стартовые значения из спецификации.
WORKERS=2               # задач одновременно
QUEUE_SIZE=20           # задач в ожидании
USER_ACTIVE_JOBS=1      # активных задач на пользователя
USER_DAILY_QUOTA=20     # задач на пользователя в сутки, 0 — без лимита
MAX_FILE_MB=48          # облачный Bot API принимает до 50 МБ
MAX_DURATION_MIN=60     # максимальная длительность ролика или фрагмента
JOB_TIMEOUT=10          # минут на одну задачу
PRECISE_CUT_MAX_MIN=10  # фрагменты MP4 до этой длины режутся кадр в кадр

# Исходящий прокси для yt-dlp, если YouTube ограничивает IP сервера.
PROXY_URL=
# Аккаунт YouTube для видео с возрастным ограничением: без него такие ролики
# не скачать. Либо файл cookies.txt, либо имя браузера, где выполнен вход
# (chrome, firefox, brave, edge, safari...). Аккаунт используется только для
# роликов с ограничением. YouTube может заблокировать аккаунт за скачивание —
# лучше завести отдельный.
YTDLP_COOKIES_FILE=
YTDLP_COOKIES_BROWSER=
# Локальный Bot API server (этап 3 спецификации), например http://localhost:8081.
# С ним MAX_FILE_MB можно поднять до 2000.
BOT_API_URL=

# Расшифровка речи через whisper.cpp (brew install whisper-cpp). Модели —
# в data/models, как скачать — в README. Без модели кнопки «Текст» нет.
WHISPER_MODEL=data/models/ggml-large-v3-turbo-q5_0.bin
WHISPER_VAD_MODEL=data/models/ggml-silero-v5.1.2.bin  # тишина и музыка, необязательна
WHISPER_LANGUAGE=auto   # или ru, en, ...
WHISPER_THREADS=4

# Где лежат состояние и временные файлы; по умолчанию — в папке проекта.
DATA_DIR=data
TMP_DIR=tmp

# Пути к программам, если их нет в PATH.
YTDLP_PATH=yt-dlp
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
WHISPER_PATH=whisper-cli

LOG_LEVEL=info          # debug, info, warn, error
